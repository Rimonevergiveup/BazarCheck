# ============================================================================
# BazarCheck (Flutter) — .gitignore
# ============================================================================
# NOTE: the previous version of this file had Python virtualenv patterns pasted
# into it (venv/, lib/, lib64/, bin/, include/). In Python `lib/` is a venv
# directory; in Flutter it is ALL of the source code — so every Dart file in
# this project was silently excluded from version control.
#
# It also ignored ios/Runner.xcodeproj/project.pbxproj and the .xcworkspace,
# which must be committed or nobody else can build the iOS app.
#
# What follows is the standard Flutter template: build output and local tooling
# state only.
# ============================================================================

# --- Dart / Flutter build output -------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# --- Generated code ---------------------------------------------------------
*.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart

# --- Platform ephemeral (regenerated by `flutter pub get`) ------------------
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
windows/flutter/ephemeral/
ios/Flutter/ephemeral/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
macos/Flutter/Flutter-Generated.xcconfig
macos/Flutter/ephemeral/flutter_export_environment.sh

# --- Android ----------------------------------------------------------------
android/.gradle/
android/app/build/
android/local.properties
android/key.properties
android/**/gradle-wrapper.jar
*.jks
*.keystore

# --- iOS / macOS ------------------------------------------------------------
ios/Pods/
ios/.symlinks/
ios/Podfile.lock
macos/Pods/
**/xcuserdata/
**/DerivedData/
*.mobileprovision

# --- Windows / Linux --------------------------------------------------------
windows/runner/Debug/
windows/runner/Release/
windows/runner/Profile/

# --- Coverage ---------------------------------------------------------------
coverage/
*.lcov

# --- IDE --------------------------------------------------------------------
.idea/
*.iml
*.iws
.vscode/
!.vscode/launch.json
!.vscode/settings.json

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
