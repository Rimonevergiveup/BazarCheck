# Porokh Price Service — environment
#
# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Supabase (required for the insight endpoints) -------------------------
# The service reads price data as an ANONYMOUS user, through the same RLS
# policies as the app. It deliberately does NOT use the service_role key —
# it only needs public reads, so holding an all-powerful key would be
# unnecessary risk.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- CORS ------------------------------------------------------------------
# Comma-separated allowed origins. Never use "*" in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Behaviour -------------------------------------------------------------
# A price not re-checked within this many days is reported as stale.
STALE_AFTER_DAYS=7
# Days of price_history used for trend detection.
HISTORY_WINDOW_DAYS=30
# Per-IP request cap. In-process only — put a real limiter at the edge
# (nginx / Cloudflare) before running more than one instance.
RATE_LIMIT_PER_MINUTE=60

# --- Server ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Never enable reload in production.
API_RELOAD=false
LOG_LEVEL=INFO

# Removed: DATABASE_URL, REDIS_URL and MODEL_PATH were declared but never read
# by any code. API_DEBUG=True was removed too — it encouraged shipping debug mode.
